# Copia este fichero a .env y ajusta los valores. NUNCA commitees el .env real.
# Puerto de la API dummy (por defecto 8000).
PORT=8000

# Origen permitido del frontend (CORS allow-list). Por defecto el dev server de Vite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NOTA DE SEGURIDAD (prototipo):
# Esta API es DUMMY y NO contiene secretos reales. En producción, la autenticación
# debe realizarse contra el API de Login Único de A.M.A. (OIDC/OAuth2) y cualquier
# secreto (client secret, certificados) debe cargarse desde un vault (Azure Key Vault),
# nunca desde el código ni desde ficheros en texto plano.
